{
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "paths": {
      "@baseline-kit/core": ["./packages/core/src/index.ts"],
      "@baseline-kit/core/*": ["./packages/core/src/*"],
      "@baseline-kit/dom": ["./packages/dom/src/index.ts"],
      "@baseline-kit/dom/*": ["./packages/dom/src/*"],
      "@baseline-kit/react": ["./packages/react/src/index.ts"],
      "@baseline-kit/react/*": ["./packages/react/src/*"],
      "@baseline-kit/remix": ["./packages/remix/src/index.ts"],
      "@baseline-kit/remix/*": ["./packages/remix/src/*"]
    }
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules", "dist"]
}
