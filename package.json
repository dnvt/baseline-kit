{
  "scripts": {
    "build": "vite build && vite build --config vite.remix.config.ts && rollup -c rollup.declarations.config.mjs && node scripts/build-css.js && node scripts/verify-artifacts.js",
    "changeset": "changeset",
    "dev": "vite --config tests/browser/vite.config.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "lint": "eslint packages --fix",
    "lint:check": "eslint packages",
    "prepack": "bun run build",
    "release": "changeset publish",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:react-core": "vitest run --exclude \"tests/remix/**\"",
    "test:browser": "playwright test",
    "test:browser:repeat": "node scripts/repeat-browser-gate.js",
    "test:integration:remix": "node scripts/test-remix-package.js",
    "typecheck": "tsc --noEmit",
    "verify:integration": "bun run typecheck && bun run lint:check && bun run test:unit && bun run build && bun run test:integration:remix && bun run test:browser:repeat",
    "version": "changeset version"
  },
  "packageManager": "bun@1.3.12",
  "peerDependencies": {
    "remix": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2 || ^6.0.0 || ^7.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "remix": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "main": "dist/index.cjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "remix",
    "grid",
    "typescript",
    "baseline",
    "guide",
    "box",
    "typography",
    "spacing",
    "padding",
    "debug",
    "dev-tool",
    "pixel-perfect",
    "vertical-rhythm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnvt/baseline-kit.git"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@typescript/typescript6": "^6.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remix": "3.0.0",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "name": "baseline-kit",
  "version": "7.0.0",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.28.2"
  },
  "homepage": "https://github.com/dnvt/baseline-kit#readme",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs",
      "default": "./dist/core.mjs"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "default": "./dist/remix.mjs"
    },
    "./remix/server": {
      "types": "./dist/remix-server.d.ts",
      "default": "./dist/remix-server.mjs"
    },
    "./styles": {
      "types": "./dist/css.d.ts",
      "default": "./dist/styles.css"
    },
    "./theme": {
      "types": "./dist/css.d.ts",
      "default": "./dist/theme.css"
    },
    "./theme/default": {
      "types": "./dist/css.d.ts",
      "default": "./dist/theme/default.css"
    },
    "./theme/dark": {
      "types": "./dist/css.d.ts",
      "default": "./dist/theme/dark.css"
    },
    "./reset": {
      "types": "./dist/css.d.ts",
      "default": "./dist/reset.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.js",
    "dist/*.map",
    "dist/*.d.ts",
    "dist/*.css",
    "dist/theme",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "bugs": {
    "url": "https://github.com/dnvt/baseline-kit/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Francois Denavaut",
  "description": "Baseline grid overlays and baseline-aware spacing for React 19 and Remix 3, with one shared stylesheet."
}
