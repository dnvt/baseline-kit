{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": ".",
    "stripInternal": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": false
  },
  "include": [
    "packages/core/src",
    "packages/dom/src",
    "packages/react/src",
    "packages/remix/src"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.*", "src/test", "vitest.*"]
}
